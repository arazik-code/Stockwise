<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FlexShoes Stock</AssemblyName>
    <RootNamespace>SMS.Desktop</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>FlexShoes</Authors>
    <Title>FlexShoes Stock</Title>
    <Description>FlexShoes Stock Management System</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
  <ItemGroup>
    <None Update="icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- RemoteApiUrl empty by default - the app behaves exactly as it always has (local only)
         until this is filled in once the VPS exists. NOTE: republishing resets this file back to
         the empty template, same as appsettings.Production.json/.env.prod already work in this
         repo - re-apply the real value in the installed location after each fresh deploy. -->
    <None Update="desktop-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
