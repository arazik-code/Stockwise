<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FlexShoes Stock</AssemblyName>
    <RootNamespace>SMS.Desktop</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>FlexShoes</Authors>
    <Title>FlexShoes Stock</Title>
    <Description>FlexShoes Stock Management System</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
  <ItemGroup>
    <None Update="icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
