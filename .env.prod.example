# Production environment variables for docker-compose.prod.yml (Hostinger VPS deployment).
#
# Copy this file to .env.prod (gitignored, never commit it) and fill in real values:
#   cp .env.prod.example .env.prod
#
# JWT_SECRET and SYNC_API_KEY must be IDENTICAL to the values in the local-fallback desktop
# install's config (see deploy/.env) - see the plan doc's Architecture Decision #4 for why.
# DB_PASSWORD does NOT need to match the local fallback's own Postgres password - they're
# separate databases.

# The real domain/subdomain pointed at this VPS (DNS A record already set up before first run,
# or Caddy's automatic HTTPS will fail to issue a certificate).
DOMAIN=flexshoes.cloud
CORS_ALLOWED_ORIGIN=https://flexshoes.cloud

# Generate with: openssl rand -base64 48   (or reuse the value already generated into deploy/.env)
JWT_SECRET=CHANGE_ME_generate_a_random_secret_shared_with_local_fallback

# Postgres password for THIS VPS's database - independent from the local fallback's own password.
DB_PASSWORD=CHANGE_ME_generate_a_strong_random_password

# Static credential the local nightly sync worker (Phase 4) presents to authenticate against
# GET /api/sync/snapshot - must match the local machine's copy of this same value.
SYNC_API_KEY=CHANGE_ME_generate_a_random_key_shared_with_local_fallback
